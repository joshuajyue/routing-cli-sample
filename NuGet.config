<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Microsoft.Extensions.AI 10.9.0 is not on nuget.org yet, so the routing types come from
      packages built locally into ./local-packages. See the README. Once 10.9.0 ships you can
      delete this source and set MeaiVersion to 10.9.0.
    -->
    <add key="local" value="local-packages" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
