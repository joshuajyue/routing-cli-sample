<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RoutingChat</RootNamespace>
    <AssemblyName>routing-chat</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The routing types are experimental. -->
    <NoWarn>$(NoWarn);MEAI001</NoWarn>

    <!-- Routing ships in 10.9.0. See the README for building it locally until then. -->
    <MeaiVersion Condition="'$(MeaiVersion)' == ''">10.9.0-dev</MeaiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="$(MeaiVersion)" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
  </ItemGroup>

</Project>
